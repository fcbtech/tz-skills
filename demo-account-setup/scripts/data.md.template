price = 45
type = "Both"

[[BOM.RM]]
qty = 1
unit = "Nos"
name = "Motor Shaft"
price = 110
type = "Both"

[[BOM.RM]]
qty = 1
unit = "Nos"
name = "Motor Housing"
price = 180
type = "Both"

# ---- Level 0 (top): TABLE FAN — the sellable finished good -------------------
[[BOM]]
[BOM.FG]
qty = 1
unit = "Nos"
name = "Table Fan 400mm"
price = 2200
type = "Sell"

# Final assembly + testing labour, machinery, running test electricity, packaging
