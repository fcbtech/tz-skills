# --- Bill of Materials -------------------------------------------------------
#
# ►► The fan below is ONE ILLUSTRATION of the method — NOT a shape to copy. ◄◄
# Every good gets its OWN unique structure, designed from how THAT good is really
# made. Do not force another good into a fan-like, motor-deep shape: a shirt nests
# at its collar, a masala pack at its spice blend, a repair kit not at all. Derive
# the tree from the actual product; it may look nothing like this fan.
#
# The DEFAULT shape is a REALISTIC MULTI-LEVEL tree — the way goods are actually
# made — NOT a fixed count of flat BOMs. The number of BOMs, the number of items,
# how deep it nests, and WHERE it nests all FLEX with the finished good. See
# SKILL.md > "Author the BOM tree" for the full method. The core rule per part:
#
#   Does the company MAKE this from other things, or BUY it finished?
#     MAKE  -> it is a SUB-ASSEMBLY: give it its own [[BOM]] block and recurse
#              into its parts. Link it into its parent's [[BOM.RM]] with
#              `child_bom = true`.
#     BUY   -> it is a LEAF: just a [[BOM.RM]] line, no block of its own.
#
# Build BOTTOM-UP: a child's [[BOM]] block MUST appear BEFORE the parent that
# consumes it (so it is published first). Go deep only in the 1–2 branches that
# are the heart of the product; let everything else bottom out fast.
#
# HARD CAP: the deduped unique-item set (every FG + sub-assembly + leaf + SCRAP
# item, by name) must be <= 20. This is a server-load ceiling, not a guideline —
# 003 aborts and creates nothing if the tree exceeds 20. Keep the tree focused and
# reuse shared parts to stay under it. Scrap items count too, so budget them into
# the 20. (The fan example below is 20 items: 18 material + 2 scrap.)
#
# Typing (keeps the downstream PO/sales scripts happy, whatever the tree shape):
#   - the TOP finished good is "Sell"
#   - every sub-assembly is "Both" (it is manufactured AND consumed as a line)
#   - every bought leaf is "Both" (purchased input, also resellable)
# A sub-assembly must use the SAME unit and price wherever it appears (as its own
# FG and as a child line). Reused names collapse to one inventory item.
#
# REALISTIC COSTING (optional, per BOM) — make each finished good's cost real:
#   rolled-up material  +  labour/machinery/electricity/other charges
#                       −  scrap recovery value.
#   [BOM.charges]   an optional table on a [[BOM]] block with any subset of
#                   labour / machinery / electricity / other (INR for the FG qty).
#                   Derive them from how THAT good is made — a forged/machined part
#                   is machinery-heavy, a stitched/assembled one labour-heavy; a
#                   simple pack barely any. Not fixed numbers.
#   [[BOM.scrap]]   optional byproduct rows (name, qty, unit, price, type). SCRAP IS
#                   AN INVENTORY ITEM (003 creates it; it counts toward the cap) —
#                   its per-unit price (price/qty) IS the recovery value credited
#                   against the FG cost. A scrap can be sold (recovered) OR reused
#                   as an input: to reuse it, give it the SAME name as an [[BOM.RM]]
#                   somewhere (names dedup to one item), so the byproduct feeds back
#                   into manufacturing. Derive scrap from the real offcuts/turnings
#                   of making the good; some goods produce none — then omit it.
#   Both are OPTIONAL: omit [BOM.charges] ⇒ zero charges; omit [[BOM.scrap]] ⇒ no
#   scrap. See SKILL.md > "Realistic costing" for the full method.
#
# The worked example below is a 400mm table fan: 3 BOMs, 3 levels, 20 items
# (18 material + 2 scrap) — deep through the motor (Fan -> Motor Assembly ->
# Stator), flat elsewhere, with realistic per-BOM charges and scrap byproducts
# (copper offcuts at the stator, sheet-metal scrap at final assembly).
# (For a quick, non-realistic seed instead, a FLAT set of single-level BOMs is a
# supported option — see SKILL.md.)

# ---- Level 2 (deepest): STATOR — wound in-house from copper + core ----------
[[BOM]]
[BOM.FG]
qty = 1
unit = "Nos"
name = "Stator 400mm"
price = 480
type = "Both"

# Winding is manual + a winding machine; small electricity draw. (material ~459)
[BOM.charges]
labour = 55
machinery = 25
electricity = 12
other = 5

[[BOM.RM]]
qty = 0.35
unit = "Kg"
name = "Copper Winding Wire"
price = 315
type = "Both"

[[BOM.RM]]
qty = 1
unit = "Nos"
name = "Stator Stamping Core"
price = 120
type = "Both"

[[BOM.RM]]
qty = 2
unit = "Nos"
name = "Insulation Paper"
price = 12
type = "Both"

# Copper offcuts from winding — sold as scrap. Recovery = price/qty = 500/Kg.
[[BOM.scrap]]
qty = 0.03
unit = "Kg"
name = "Copper Scrap"
price = 15
type = "Both"

# ---- Level 1: MOTOR ASSEMBLY — assembled from the stator + bought parts ------
[[BOM]]
[BOM.FG]
qty = 1
unit = "Nos"
name = "Motor Assembly 400mm"
price = 1350
type = "Both"

# Bearing/shaft press-fit + assembly labour; light electricity. (material ~995)
[BOM.charges]
labour = 85
machinery = 40
electricity = 18
other = 8

[[BOM.RM]]
qty = 1
unit = "Nos"
name = "Stator 400mm"
price = 480
type = "Both"
child_bom = true            # links the Stator BOM published above (level 2)

[[BOM.RM]]
qty = 2
unit = "Nos"
name = "Ball Bearing 6202"
price = 90
type = "Both"

[[BOM.RM]]
